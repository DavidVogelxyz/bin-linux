#!/usr/bin/env bash

# Name:     git_package_manager
# Author:   David Vogel <david@davidvogel.xyz>
# Date:     2025 Sep 14, Sun
# License:  GPL v3.0
# Desc:     `git_package_manager` makes managing Git repos easy

SRC_DIR="${HOME}/.local/src"
MSG_REPO_UP_TO_DATE="Already up to date."

git_mgmt() {
    if ! [[ -d .git ]]; then
        dirs_not_repos+=("$dir")
        return 0
    fi

    echo "[INFO]: Attempting to update \`$dir\`."

    git fetch > /dev/null 2>&1
    local EXIT_CODE="$?"

    if [[ "$EXIT_CODE" == 128 ]]; then
        repos_bad_fetch+=("$dir")
        return 0
    fi

    # cannot use `local OUTPUT`, or `$EXIT_CODE` always equals `0`
    OUTPUT=$(git pull 2>/dev/null)
    EXIT_CODE="$?"

    if [[ "$EXIT_CODE" == 1 ]]; then
        repos_no_branch+=("$dir")
        return 0
    elif [[ "$EXIT_CODE" == 128 ]]; then
        repos_bad_pull+=("$dir")
        return 0
    fi

    if [[ "$OUTPUT" == "$MSG_REPO_UP_TO_DATE" ]]; then
        repos_no_change+=("$dir")
        return 0
    fi

    if ! [[ "$OUTPUT" == "$MSG_REPO_UP_TO_DATE" ]]; then
        repos_updated+=("$dir")
    fi
}

gpm_loop() {
    for dir in *; do
        if ! [[ -d $dir ]]; then
            not_dirs+=("$dir")
            continue
        fi

        cd $dir

        # operate within dir
        git_mgmt

        cd ..
    done
}

report_results() {
    # For Bash versions older than 4.3, uncomment the following lines and comment the "newer" version
    #local arr="$1[@]"
    #arr=("${!arr}")

    # Since Bash version 4.3 and newer, this works in place of the previous lines
    local -n arr="$1"

    local msg="$2"

    echo -e "\n${msg}"
    printf -- "- %s\n" "${arr[@]}"
}

gpm_results() {
    # Report on objects in `SRC_DIR` that are not directories
    if (( "${#not_dirs[@]}" > 0 )); then
        report_results "not_dirs" "[INFO]: The following objects are not directories:"
    fi

    # Report on directories in `SRC_DIR` that are not Git repos
    if (( "${#dirs_not_repos[@]}" > 0 )); then
        report_results "dirs_not_repos" "[INFO]: The following directories are not Git repos:"
    fi

    # Report on Git repos that were already up-to-date
    if (( "${#repos_no_change[@]}" > 0 )); then
        report_results "repos_no_change" "[INFO]: The following Git repos were already up-to-date:"
    fi

    # Report on Git repos that updated successfully
    if (( "${#repos_updated[@]}" > 0 )); then
        report_results "repos_updated" "[INFO]: The following Git repos were updated successfully:"
    fi

    # Report on Git repos that fetched successfully, but changes were not pulled
    if (( "${#repos_no_branch[@]}" > 0 )); then
        report_results "repos_no_branch" "[INFO]: The following Git repos were fetched without changing HEAD:"
    fi

    # Report on Git repos that failed to fetch
    if (( "${#repos_bad_fetch[@]}" > 0 )); then
        report_results "repos_bad_fetch" "[WARN]: The following Git repos did not fetch cleanly:"
    fi

    # Report on Git repos that failed to pull
    if (( "${#repos_bad_pull[@]}" > 0 )); then
        report_results "repos_bad_pull" "[WARN]: The following Git repos did not pull cleanly:"
    fi
}

main() {
    if ! [[ "$(command -v git)" ]]; then
        error "[ERROR]: Git does not appear to be installed. Exiting now."
    fi

    local not_dirs=()
    local dirs_not_repos=()
    local repos_bad_fetch=()
    local repos_no_branch=()
    local repos_bad_pull=()
    local repos_no_change=()
    local repos_updated=()

    # If provided a valid directory as an argument, `cd` to it
    # Otherwise, change directory to `SRC_DIR`
    if [[ -d "$1" ]]; then
        cd "$1"
    else
        cd $SRC_DIR
    fi

    gpm_loop
    gpm_results
}

main "$@"
